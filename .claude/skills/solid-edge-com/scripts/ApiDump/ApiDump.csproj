<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- A automação do Solid Edge 2026 é x64 puro; manter o dump no mesmo
         bitness do servidor COM evita ler uma typelib com o marshaller errado. -->
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>ApiDump</AssemblyName>
    <RootNamespace>SeApiRecon.ApiDump</RootNamespace>
  </PropertyGroup>

</Project>
