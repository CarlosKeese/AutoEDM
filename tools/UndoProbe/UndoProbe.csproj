<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sonda da PRÉVIA (desfazer/transação, Carlos 2026-10-29): console que se ANEXA à Solid Edge aberta e
    trabalha só em peças DESCARTÁVEIS criadas por ela, fechadas sem salvar. Fora do AutoEDM.sln de propósito.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>AutoEDM.Tools.UndoProbe</RootNamespace>
    <AssemblyName>UndoProbe</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <!-- x64 obrigatório: um build 32 bits simplesmente não conecta na SE. -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64;AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoEDM.Core\AutoEDM.Core.csproj" />
  </ItemGroup>

</Project>
